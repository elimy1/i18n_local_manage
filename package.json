{
    "name":  "i18n-codemod",
    "private":  true,
    "version":  "0.1.0",
    "description":  "Extract hard-coded strings into i18n catalogs — safely, verifiably, and with coverage you can put in CI.",
    "license":  "MIT",
    "type":  "module",
    "engines":  {
                    "node":  "\u003e=20"
                },
    "scripts":  {
                    "build":  "node scripts/build.mjs",
                    "test":  "node scripts/test.mjs",
                    "typecheck":  "pnpm -r run typecheck",
                    "cli":  "node packages/cli/dist/index.js"
                },
    "workspaces":  [
                       "packages/*"
                   ],
    "devDependencies":  {
                            "@types/node":  "^26.6.6",
                            "typescript":  "5.9.3"
                        }
}