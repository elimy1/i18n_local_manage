{
  "name": "@i18n-codemod/adapters",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist-cjs/index.js"
    }
  },
  "files": ["dist", "dist-cjs"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node test/run.mjs"
  },
  "dependencies": {
    "@i18n-codemod/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
